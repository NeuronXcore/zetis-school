{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "scripts/with-worker.sh",
        "pnpm",
        "dev:back"
      ],
      "port": 8000
    },
    {
      "name": "massimo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@zetis/frontend-massimo",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "papa",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@zetis/frontend-papa",
        "dev"
      ],
      "port": 5174,
      "autoPort": true
    },
    {
      "name": "backend-dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "scripts/with-worker.sh",
        "sh",
        "-c",
        "cd apps/backend && ZETIS_CORS_ORIGINS='[\"http://localhost:5175\",\"http://localhost:5176\",\"http://localhost:5177\"]' .venv/bin/uvicorn app.main:app --reload --port 8001"
      ],
      "port": 8001
    },
    {
      "name": "backend-dev2",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "scripts/with-worker.sh",
        "sh",
        "-c",
        "cd apps/backend && ZETIS_CORS_ORIGINS='[\"http://localhost:5177\",\"http://localhost:5178\"]' .venv/bin/uvicorn app.main:app --reload --port 8002"
      ],
      "port": 8002
    },
    {
      "name": "papa-dev2",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd apps/frontend-papa && VITE_API_URL=http://localhost:8002 npx vite --port 5178 --strictPort"
      ],
      "port": 5178
    },
    {
      "name": "papa-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd apps/frontend-papa && VITE_API_URL=http://localhost:8001 npx vite --port 5175 --strictPort"
      ],
      "port": 5175
    },
    {
      "name": "massimo-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd apps/frontend-massimo && VITE_API_URL=http://localhost:8001 npx vite --port 5176 --strictPort"
      ],
      "port": 5176
    },
    {
      "name": "massimo-dev2",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd apps/frontend-massimo && VITE_API_URL=http://localhost:8002 npx vite --port 5177 --strictPort"
      ],
      "port": 5177
    },
    {
      "name": "backend-galaxy",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "scripts/with-worker.sh",
        "sh",
        "-c",
        "cd apps/backend && ZETIS_CORS_ORIGINS='[\"http://localhost:5179\"]' .venv/bin/uvicorn app.main:app --reload --port 8003"
      ],
      "port": 8003
    },
    {
      "name": "massimo-galaxy",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd apps/frontend-massimo && VITE_API_URL=http://localhost:8003 npx vite --port 5179 --strictPort"
      ],
      "port": 5179
    },
    {
      "name": "papa-srs",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd apps/frontend-papa && VITE_API_URL=http://localhost:8001 npx vite --port 5177 --strictPort"
      ],
      "port": 5177
    },
    {
      "// paire LAN": "Seule paire joignable depuis un VRAI iPhone. Toutes les autres lient 127.0.0.1 : le téléphone ne peut atteindre AUCUN de leurs ports, quelle que soit l'URL tapée. Quatre choses doivent changer ENSEMBLE, et il en manque toujours une : (1) uvicorn --host 0.0.0.0, (2) vite --host 0.0.0.0, (3) VITE_API_URL sur l'IP du Mac — sur localhost le téléphone appellerait SON PROPRE localhost, (4) l'origine LAN dans ZETIS_CORS_ORIGINS, que le défaut (:5173/:5174) n'a pas. L'IP se résout au lancement : elle bouge au gré du DHCP.",
      "// piège en0": "en0 est le Wi-Fi. Le Mac a AUSSI une route par défaut sur en10 (filaire) — c'est cette adresse-là qu'on relève par réflexe, et le téléphone, qui est en Wi-Fi, ne la joint pas.",
      "name": "backend-lan",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "scripts/with-worker.sh",
        "sh",
        "-c",
        "IP=$(ipconfig getifaddr en0) && echo \"[LAN] backend sur http://$IP:8004\" && cd apps/backend && ZETIS_CORS_ORIGINS=\"[\\\"http://$IP:5180\\\",\\\"http://localhost:5180\\\"]\" .venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8004"
      ],
      "port": 8004
    },
    {
      "name": "massimo-lan",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "IP=$(ipconfig getifaddr en0) && echo \"[LAN] ouvre http://$IP:5180 sur l'iPhone\" && cd apps/frontend-massimo && VITE_API_URL=http://$IP:8004 npx vite --host 0.0.0.0 --port 5180 --strictPort"
      ],
      "port": 5180
    }
  ]
}
