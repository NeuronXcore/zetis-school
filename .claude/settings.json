{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -c ' *)",
      "Bash(awk 'NR>=1 && NR<=24 {print NR\": \"substr\\($0,1,110\\)}' DECISIONS.md)",
      "Bash(awk '{print \"RAM: \" $2/1073741824 \" GB\"}')",
      "Bash(docker compose *)",
      "Bash(docker compose exec -T postgres psql -U zetis -d zetis -t -c ' *)",
      "Bash(docker volume *)",
      "Bash(gh pr merge:*)",
      "Bash(git check-ignore *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git ls-remote *)",
      "Bash(graphify query *)",
      "Bash(graphify update *)",
      "Bash(grep -E \"\\\\.\\(ts|tsx\\)$\")",
      "Bash(grep -E \"\\\\\\\\.py$\")",
      "Bash(grep -v '^$')",
      "Bash(grep -v 'refs/heads/main$')",
      "Bash(ls apps/backend/.venv/bin/python 2>/dev/null; grep -rn \"DATABASE_URL\\\\|database_url\" .env apps/backend/.env 2>/dev/null | sed 's/:\\\\/\\\\/[^@]*@/:\\\\/\\\\/***@/' | head)",
      "Bash(npm ls *)",
      "Bash(npx tsc *)",
      "Bash(pip3 show *)",
      "Bash(pnpm --filter @zetis/frontend-papa test -- --run)",
      "Bash(python3 -)",
      "Bash(python3 -c \"import mlx; print\\('mlx', mlx.__version__\\)\")",
      "Bash(python3 -c \"import sys,json; d=json.load\\(sys.stdin\\); print\\('\\\\n'.join\\(m['name']+' '+str\\(round\\(m['size']/1e9,1\\)\\)+'GB' for m in d.get\\('models',[]\\)\\)\\)\")",
      "Bash(python3 -c ' *)",
      "Bash(python3)",
      "Bash(sysctl -n machdep.cpu.brand_string)",
      "Bash(sysctl hw.memsize)",
      "Bash(xargs -I{} docker exec {} env)",
      "Bash(xargs cat)",
      "Bash(xargs git push origin --delete)",
      "Bash(xargs ls -1)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebSearch"
    ]
  }
}
