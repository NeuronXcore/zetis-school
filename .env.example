# =====================================================================
# ZETIS — variables d'environnement (EXEMPLE)
# Copier en `.env` et adapter. NE JAMAIS committer de `.env` réel.
# Aucune valeur ci-dessous n'est un secret réel (cf. CLAUDE.md § sécurité).
# =====================================================================

# --- PostgreSQL + pgvector ---
POSTGRES_DB=zetis
POSTGRES_USER=zetis
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://zetis:change_me_dev_password@localhost:5432/zetis

# --- Redis (cache + files de tâches) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- MinIO (fichiers : PDF, audio, images) ---
MINIO_ROOT_USER=zetis_minio
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_BUCKET_CAPSULES=capsules

# --- Capsules IA · Lot 2 (rendu MP4) ---
# Stockage du MP4 rendu : 'disk' (fallback dev) ou 'minio' (cible). L'audio reste sur disque.
STORAGE_BACKEND=disk
# File RQ consommée par worker-media (rendu Remotion sandboxé, hors backend).
RENDER_QUEUE=media
# Répertoire partagé backend ↔ worker-media pour les WAV de scènes (chemin absolu conseillé).
AUDIO_STORAGE_DIR=storage/generated
# Timeout d'un rendu Node (secondes), garde-fou worker-media.
REMOTION_TIMEOUT=600

# --- API backend (FastAPI) ---
API_PORT=8000
SECRET_KEY=change_me_generate_a_long_random_value
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Frontends (Vite) ---
VITE_API_URL=http://localhost:8000

# --- Fournisseur IA (abstraction provider — cf. CLAUDE.md § Règles IA) ---
AI_PROVIDER=ollama
# Clés cloud : lues par scripts/bench_llm.py (benchmark) et, SEULE exception de production,
# par les tâches `curriculum_*` (génération du référentiel de programme — dérogation étroite
# ADR-0009, addendum : zéro donnée de Massimo dans ces prompts, tâche one-shot Papa).
# Toutes les autres tâches restent 100 % locales (ADR-0008). `.env` reste git-ignoré.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# --- Référentiel de programme (ADR-0009) : provider des tâches curriculum_* uniquement. ---
# 'anthropic' (défaut, nécessite ANTHROPIC_API_KEY) ; sans clé le service REFUSE avec un
# message clair — repli local explicite : CURRICULUM_LLM_PROVIDER=ollama (qualité moindre,
# cf. bench T4). Jamais de bascule silencieuse.
# CURRICULUM_LLM_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3.6:35b-a3b   # MoE retenu (ADR-0008 ph.2) ; qwen3* → think:false auto
# Génération sur MLX (Apple Silicon, ADR-0008) : LLM_PROVIDER=mlx + mlx_lm.server sur :8080.
# LLM_PROVIDER=ollama
# MLX_BASE_URL=http://localhost:8080
# MLX_MODEL=mlx-community/Qwen2.5-32B-Instruct-4bit

# --- Missions (ADR-0017 lot 1) : XP d'effort + seuils du verdict d'acquisition ---
# XP crédité à la complétion, inconditionnel (récompense l'effort). Le verdict acquired
# exige score reverse ET score quiz ≥ seuils ; sinon review_later (notion revient via SRS).
# MISSION_XP_REWARD=50
# MISSION_REVERSE_THRESHOLD=70
# MISSION_QUIZ_THRESHOLD=70
# MISSION_MINDMAP_THRESHOLD=70   # (ADR-0019) seuil du signal de rappel « mindmap » dans le verdict
# Sélecteur de la mission du jour (lot 2) : scoring déterministe versionné. Bump de version à
# tout changement de facteur/pondération. `variety` est un malus (anti-répétition de matière).
# MISSION_SCORING_VERSION=v3   # v3 (ADR-0019) : step mindmap + verdict option B ; v2 (ADR-0018) : forced_priority par flag
# MISSION_WEIGHT_SEVERITY=1.0
# MISSION_WEIGHT_DUE_PRESSURE=0.8
# MISSION_WEIGHT_CONTINUITY=0.6
# MISSION_WEIGHT_VARIETY=0.5
# MISSION_WEIGHT_FORCED_PRIORITY=100.0
# MISSION_DUE_PRESSURE_CAP=6

# Commander une mission (ADR-0018) : Papa apporte le scope, ZETIS résout les notions fragiles,
# une mission mono-skill par notion cochée. Seuil/plafond versionnés (MISSION_COMMAND_VERSION).
# MISSION_COMMAND_VERSION=v1
# MISSION_COMMAND_MASTERED_THRESHOLD=0.8
# MISSION_COMMAND_MAX_SKILLS=3

# --- RAG (Étape 11) : embeddings locaux + récupération sémantique pgvector ---
# Nécessite `ollama pull nomic-embed-text` (768 dimensions).
# Découplé de LLM_PROVIDER (ADR-0008) : reste sur ollama même si génération=mlx.
# EMBED_PROVIDER=ollama
# OLLAMA_EMBED_MODEL=nomic-embed-text
# EMBED_DIM=768
# RAG_TOP_K=3
