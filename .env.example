# =====================================================================
# ZETIS — variables d'environnement (EXEMPLE)
# Copier en `.env` et adapter. NE JAMAIS committer de `.env` réel.
# Aucune valeur ci-dessous n'est un secret réel (cf. CLAUDE.md § sécurité).
# =====================================================================

# --- PostgreSQL + pgvector ---
POSTGRES_DB=zetis
POSTGRES_USER=zetis
# 🔴 OBLIGATOIRE pour `pnpm prod:up` depuis l'ADR-0046 : le compose de prod n'a plus de
# valeur par défaut (`${POSTGRES_PASSWORD:?…}`). Sans elle, `prod:up` s'arrête avec un
# message, au lieu de démarrer une base ouverte avec un secret écrit dans le dépôt.
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_PORT=5432
# ⚠️ Le préfixe `ZETIS_` n'est PAS décoratif : `Settings` déclare `env_prefix="ZETIS_"` et
# `database_url` n'a aucun `validation_alias`. Une variable nommée `DATABASE_URL` toute seule est
# donc **ignorée par le backend**, qui repart en silence sur son défaut (localhost, mot de passe de
# dev). Ce fichier l'annonçait sans préfixe depuis l'origine — corrigé le 2026-08-04.
ZETIS_DATABASE_URL=postgresql+psycopg://zetis:change_me_dev_password@localhost:5432/zetis

# --- Redis (cache + files de tâches) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- MinIO (fichiers : PDF, audio, images) ---
MINIO_ROOT_USER=zetis_minio
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# 🔴 La stack PROD publie MinIO sous des noms DISTINCTS, et ce n'est pas cosmétique : les deux
# compose lisent CE fichier. Sous un nom commun, poser la variable déplacerait dev et prod
# ensemble, et les empêcherait de nouveau de tourner sur la même machine (le Mac Studio héberge
# les deux). Seule la console d'admin passe par ces ports — le navigateur ne parle jamais à MinIO.
MINIO_PORT_PROD=9002
MINIO_CONSOLE_PORT_PROD=9003
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_BUCKET_CAPSULES=capsules

# --- Capsules IA · Lot 2 (rendu MP4) ---
# Stockage du MP4 rendu : 'disk' (fallback dev) ou 'minio' (cible). L'audio reste sur disque.
STORAGE_BACKEND=disk
# File RQ consommée par worker-media (rendu Remotion sandboxé, hors backend).
RENDER_QUEUE=media
# Répertoire partagé backend ↔ worker-media pour les WAV de scènes (chemin absolu conseillé).
AUDIO_STORAGE_DIR=storage/generated
# Timeout d'un rendu Node (secondes), garde-fou worker-media.
REMOTION_TIMEOUT=600

# --- Dictée (STT, ADR-0012) : Whisper LOCAL via faster-whisper ---
# 100 % local, aucun tiers : c'est la voix de Massimo (CLAUDE.md § sécurité).
# ⚠️ Le groupe entier MANQUAIT à ce fichier jusqu'au 2026-08-13, alors que les quatre variables
# étaient lues depuis l'ADR-0012 — ajouté à la clôture de la slice 2 des fiches.
# ⚠️ Dépendance OPTIONNELLE, installation one-time : `pip install -e '.[stt]'` dans le venv
# backend. Sans elle, `/transcribe` répond **503** et le frontend masque le micro (dégradation
# propre, jamais de bascule silencieuse vers un service tiers).
# Deux consommateurs depuis le 2026-08-13 : ELI5 et l'atelier de fiche (`fiche_transcribe`).
# STT_PROVIDER=faster-whisper
# 'small' (défaut) = rapide sur CPU/Apple Silicon, déjà bon en français.
# Plus précis et plus lent : 'medium', ou 'large-v3' (~3 Go).
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# 'int8' (défaut) = rapide/léger ; 'int8_float16' ou 'float32' grappillent un peu de précision.
# Le levier dominant reste la taille du modèle, pas ce réglage.
# WHISPER_COMPUTE_TYPE=int8

# --- API backend (FastAPI) ---
API_PORT=8000
SECRET_KEY=change_me_generate_a_long_random_value
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Frontends (Vite) ---
VITE_API_URL=http://localhost:8000

# --- Fournisseur IA (abstraction provider — cf. CLAUDE.md § Règles IA) ---
AI_PROVIDER=ollama
# Clés cloud : lues par scripts/bench_llm.py (benchmark) et, SEULE exception de production,
# par les tâches `curriculum_*` (génération du référentiel de programme — dérogation étroite
# ADR-0009, addendum : zéro donnée de Massimo dans ces prompts, tâche one-shot Papa).
# Toutes les autres tâches restent 100 % locales (ADR-0008). `.env` reste git-ignoré.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# --- Référentiel de programme (ADR-0009) : provider des tâches curriculum_* uniquement. ---
# 'anthropic' (défaut, nécessite ANTHROPIC_API_KEY) ; sans clé le service REFUSE avec un
# message clair — repli local explicite : CURRICULUM_LLM_PROVIDER=ollama (qualité moindre,
# cf. bench T4). Jamais de bascule silencieuse.
# CURRICULUM_LLM_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3.6:35b-a3b   # MoE retenu (ADR-0008 ph.2) ; qwen3* → think:false auto
# Génération sur MLX (Apple Silicon, ADR-0008) : LLM_PROVIDER=mlx + mlx_lm.server sur :8080.
# LLM_PROVIDER=ollama
# MLX_BASE_URL=http://localhost:8080
# MLX_MODEL=mlx-community/Qwen2.5-32B-Instruct-4bit

# --- Agenda scolaire (ADR-0025) : source exogène, déclarative, NON probante ---
# Verrou de phase (§10). Phase 0 (défaut) : Papa écrit, Massimo lit / coche / masque —
# POST /api/student/agenda/items répond 403. Phase 1 : Papa bascule le flag, le composer
# élève s'ouvre. Le verrou est SERVEUR : une UI cachée n'est pas une règle.
# `done` et `dismiss` ne sont JAMAIS concernés par ce flag.
# AGENDA_STUDENT_ENTRY_ENABLED=false
# Bande glissante : 3 jours avant / aujourd'hui / 10 après (14 colonnes). Jamais la semaine
# calendaire. Asymétrie volontaire : tout l'horizon va vers l'avant, le regard en arrière reste
# borné à 3 jours (un passé qu'on parcourt rend les trous visibles).
# AGENDA_BAND_DAYS_BEFORE=3
# AGENDA_BAND_DAYS_AFTER=10
# Traces d'un jour passé : nombre d'activités distinctes, plafonné (ni durée, ni score).
# AGENDA_TRACES_CAP=3
# « Ce qui arrive » : contrôles et rendus seulement, horizon et liste bornés.
# AGENDA_UPCOMING_HORIZON_DAYS=21
# AGENDA_UPCOMING_MAX=4

# --- Missions (ADR-0017 lot 1) : XP d'effort + seuils du verdict d'acquisition ---
# XP crédité à la complétion, inconditionnel (récompense l'effort). Le verdict acquired
# exige score reverse ET score quiz ≥ seuils ; sinon review_later (notion revient via SRS).
# MISSION_XP_REWARD=50
# MISSION_REVERSE_THRESHOLD=70
# MISSION_QUIZ_THRESHOLD=70
# MISSION_MINDMAP_THRESHOLD=70   # (ADR-0019) seuil du signal de rappel « mindmap » dans le verdict
# Sélecteur de la mission du jour (lot 2) : scoring déterministe versionné. Bump de version à
# tout changement de facteur/pondération. `variety` est un malus (anti-répétition de matière).
# MISSION_SCORING_VERSION=v3   # v3 (ADR-0019) : step mindmap + verdict option B ; v2 (ADR-0018) : forced_priority par flag
# MISSION_WEIGHT_SEVERITY=1.0
# MISSION_WEIGHT_DUE_PRESSURE=0.8
# MISSION_WEIGHT_CONTINUITY=0.6
# MISSION_WEIGHT_VARIETY=0.5
# MISSION_WEIGHT_FORCED_PRIORITY=100.0
# MISSION_DUE_PRESSURE_CAP=6
# MISSION_REVISION_TOP_N=3   # (ADR-0017 §5) revision = 1 mission par notion due, top-N par retard

# Commander une mission (ADR-0018) : Papa apporte le scope, ZETIS résout les notions fragiles,
# une mission mono-skill par notion cochée. Seuil/plafond versionnés (MISSION_COMMAND_VERSION).
# MISSION_COMMAND_VERSION=v1
# MISSION_COMMAND_MASTERED_THRESHOLD=0.8
# MISSION_COMMAND_MAX_SKILLS=3


# --- Production en lot et autonomie (ADR-0031 · 0032 · 0034 · 0035 · 0036) ---
# ZETIS équipe une notion (cours → fiche → SRS → quiz → mindmap) dans un worker séparé.
# ⚠️ Les PALIERS d'autonomie ne sont PAS ici : ils vivent en base (`app_settings`), parce que Papa
# les change depuis /parametres. Ici on ne règle que les BORNES techniques du dispositif.
# PRODUCTION_QUEUE=production
# PRODUCTION_JOB_TIMEOUT=3600            # un chapitre dense ≈ 36 min (mesuré : 69 s / notion)
# PRODUCTION_MAX_PENDING=30              # arriéré de RELECTURE au-delà duquel un lot est REFUSÉ
# PRODUCTION_PAUSE_IF_ACTIVE_MINUTES=5   # « Massimo passe devant » : il travaille → le lot attend
# PRODUCTION_MAX_WAIT_MINUTES=30         # borne de cette attente : un lot qui finit > un lot qui attend
# PRODUCTION_HEARTBEAT_TIMEOUT_MINUTES=90  # au-delà, un lot `running` est rendu `stale` À LA LECTURE

# Le déclencheur automatique (ADR-0035) : ZETIS regarde l'agenda et se met au travail seul.
# ⚠️ L'INTERRUPTEUR n'est pas ici — c'est `zetis_auto_trigger_enabled` en base, armé par Papa.
# Ces clés ne font que borner ce qu'il a le droit de faire une fois armé.
# PRODUCTION_AUTO_MAX_RUNS=2             # lots automatiques par fenêtre — il REFUSE et le dit
# PRODUCTION_AUTO_WINDOW_DAYS=7
# PRODUCTION_AUTO_LOOKAHEAD_DAYS=7       # au-delà, on produirait pour un programme qui aura changé
# PRODUCTION_SCAN_INTERVAL_MINUTES=180   # le réveil REGARDE, il ne produit pas (0 = pas de scan)
# PRODUCTION_WORKER_SUPERVISED=false     # true SEULEMENT si un superviseur relance le worker
#                                        # (prod compose : restart: unless-stopped). Ouvre le geste
#                                        # « Redémarrer ce worker » ; false = refusé avec motif.

# Les demandes de Massimo (ADR-0036) : quota DISTINCT des lots d'échéance, et c'est une décision.
# Le régulateur compte des LOTS, pas du COÛT : un lot-pièce (~15 s) y pèserait autant qu'un
# lot-chapitre (~36 min). Sous un plafond commun, deux fiches demandées priveraient le contrôle
# du jeudi de sa préparation. Trois origines, trois natures.
# ZETIS_REQUEST_MAX_RUNS=10              # fenêtre partagée avec PRODUCTION_AUTO_WINDOW_DAYS
# CONTENT_REQUEST_MAX_KINDS=7            # taille max d'une demande « tout ce qui manque »

# --- Alerte « la file n'est servie par personne » (ADR-0046) ---
# Le SEUL canal sortant de ZETIS. Un watchdog dans le backend (jamais dans le worker : on ne demande
# pas au mort de constater son décès) envoie UN e-mail quand du travail attend et qu'aucun worker ne
# répond depuis N minutes.
#
# 🔴 PLANCHER DE 8 MINUTES, et c'est une MESURE : un worker `idle` ne rebat qu'à chaque tour de
# boucle de dequeue (3,8 min d'ancienneté relevés le 2026-08-08, TTL de clé Redis à 8 min). Sous 8,
# l'alarme sonnerait sur un worker en parfaite santé. Une valeur plus basse est RELEVÉE, avec un
# avertissement au démarrage — jamais refusée : un backend ne tombe pas pour un réglage d'alerting.
# PRODUCTION_ALERT_AFTER_MINUTES=15
#
# Sans SMTP_HOST ni ALERT_EMAIL_TO : le canal est INERTE, une ligne le dit au démarrage, et rien
# n'échoue. L'absence de worker reste visible dans le bandeau Papa, et nulle part ailleurs.
# ⚠️ Pourquoi un e-mail et pas Web Push : il n'existe AUCUN environnement distant (DEPLOYMENT.md),
# et le Push API exige un contexte sécurisé — il n'aurait atteint que la machine qui fait tourner
# ZETIS, celle devant laquelle Papa est déjà assis. À rouvrir le jour où l'accès distant existe.
# ALERT_EMAIL_TO=papa@exemple.fr
# ALERT_EMAIL_FROM=zetis@exemple.fr      # défaut : SMTP_USER
# SMTP_HOST=smtp.exemple.fr
# SMTP_PORT=587
# SMTP_USER=zetis@exemple.fr
# SMTP_PASSWORD=change_me               # 🔴 secret — dans le .env de la RACINE uniquement

# --- RAG (Étape 11) : embeddings locaux + récupération sémantique pgvector ---
# Nécessite `ollama pull nomic-embed-text` (768 dimensions).
# Découplé de LLM_PROVIDER (ADR-0008) : reste sur ollama même si génération=mlx.
# EMBED_PROVIDER=ollama
# OLLAMA_EMBED_MODEL=nomic-embed-text
# EMBED_DIM=768
# RAG_TOP_K=3

# --- Chat ZETIS (ADR-0026, ADR-0027, ADR-0059) ---
# ⚠️ Groupe ajouté à la clôture du 2026-08-15 : il n'existait PAS, alors que six de ces variables
# étaient lues depuis le 2026-07-29. Une variable non documentée est une variable qu'on ne sait
# pas régler en production — et la moitié de ce groupe pilote la vie privée ou la latence.
#
# Mémoire éphémère (ADR-0026 §1) : TTL glissant, reposé à chaque écriture.
# CHAT_SESSION_TTL_MINUTES=120
# CHAT_MAX_TURNS_PER_SESSION=40          # anti-spam ; au-delà → 429
#
# Contexte injecté, borné SECTION PAR SECTION (ADR-0059 §9). ⚠️ `CHAT_CONTEXT_TOKEN_BUDGET` a
# CHANGÉ DE SENS : il ne borne plus tout le bloc mais le seul RAPPEL des notions récentes.
# CHAT_CONTEXT_TOKEN_BUDGET=150          # rappel — sacrifié en premier
# CHAT_COURSE_TOKEN_BUDGET=900           # cours canonique — tronqué PAR PARAGRAPHE
# CHAT_RAG_TOKEN_BUDGET=300              # extraits — passages entiers, jamais coupés
# ⚠️ Élargir ces budgets ALLONGE la génération : le moteur pèse déjà ~9,4 s sur un tour (mesuré
# le 2026-08-15). Régler en MESURANT, jamais au jugé.
#
# CHAT_RAG_MAX_DISTANCE=0.45             # plancher de pertinence du repli RAG (distance cosinus)
# ⚠️ Seul garde-fou contre un ancrage sur un chapitre voisin : la recherche est à l'échelle de la
# MATIÈRE. Trop laxiste → ZETIS répond à côté ; trop strict → le repli ne sert jamais.
#
# Résolution question libre → notion. Relevé 0.55 → 0.72 le 2026-07-30 après un test live.
# CHAT_SKILL_RESOLUTION_MIN_SCORE=0.72
# CHAT_RECALL_WINDOW_DAYS=7              # fenêtre du rappel d'ouverture
#
# Interrogation orale (ADR-0059 §10-§11).
# CHAT_RECALL_QUESTIONS=3                # borné par l'attention d'un enfant ET par le quota de tours
# CHAT_RECALL_MIN_ANSWER_CHARS=8         # en dessous : AUCUNE évaluation (une dictée ratée ne
#                                        # produit jamais un verdict sur Massimo)
