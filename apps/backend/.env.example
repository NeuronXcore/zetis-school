# =====================================================================
# Backend ZETIS — variables d'environnement (EXEMPLE)
# Préfixe ZETIS_. Copier en .env pour surcharger. NE PAS committer de .env réel.
# =====================================================================

# --- Base de données PostgreSQL (Étape 9) ---
ZETIS_DATABASE_URL=postgresql+psycopg://zetis:zetis_dev_password@localhost:5432/zetis

# --- IA / LLM (Étape 10) : provider de génération. 'ollama' ou 'mlx' (ADR-0008) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Modèle retenu (ADR-0008 ph.2) : MoE Qwen3, qualité ≈ 72b à la vitesse la + rapide.
# Pour un qwen3*, OllamaProvider passe auto `think:false` (sinon JSON vide).
OLLAMA_MODEL=qwen3.6:35b-a3b
# MLX (Apple Silicon) : serveur OpenAI-compatible lancé via `mlx_lm.server`.
# Utilisé seulement si LLM_PROVIDER=mlx. Le backend n'importe pas `mlx` (HTTP).
MLX_BASE_URL=http://localhost:8080
MLX_MODEL=mlx-community/Qwen2.5-32B-Instruct-4bit

# --- RAG / embeddings (Étape 11) : découplé de LLM_PROVIDER (ADR-0008) ---
# Reste sur ollama même si la génération passe sur MLX → pas de migration pgvector.
EMBED_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
RAG_TOP_K=3

# --- JWT (Étape 6) ---
ZETIS_SECRET_KEY=change_me_generate_a_long_random_value
ZETIS_ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Identifiants de développement (prototype local uniquement) ---
# Les vrais utilisateurs (hashés, en base) arrivent à l'Étape 9.
ZETIS_PAPA_USERNAME=papa
ZETIS_PAPA_PASSWORD=papa1234
ZETIS_MASSIMO_USERNAME=massimo
ZETIS_MASSIMO_PASSWORD=massimo1234
