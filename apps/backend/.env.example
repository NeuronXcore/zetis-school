# =====================================================================
# Backend ZETIS — variables d'environnement (EXEMPLE)
# Préfixe ZETIS_. Copier en .env pour surcharger. NE PAS committer de .env réel.
# =====================================================================

# --- Base de données PostgreSQL (Étape 9) ---
ZETIS_DATABASE_URL=postgresql+psycopg://zetis:zetis_dev_password@localhost:5432/zetis

# --- IA / LLM (Étape 10) : un seul provider, ollama local ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:32b

# --- JWT (Étape 6) ---
ZETIS_SECRET_KEY=change_me_generate_a_long_random_value
ZETIS_ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Identifiants de développement (prototype local uniquement) ---
# Les vrais utilisateurs (hashés, en base) arrivent à l'Étape 9.
ZETIS_PAPA_USERNAME=papa
ZETIS_PAPA_PASSWORD=papa1234
ZETIS_MASSIMO_USERNAME=massimo
ZETIS_MASSIMO_PASSWORD=massimo1234
