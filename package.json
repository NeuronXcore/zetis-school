{
  "name": "zetis",
  "version": "0.1.0",
  "private": true,
  "description": "ZETIS — app éducative personnelle pour Massimo (monorepo)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "dev": "bash scripts/dev.sh",
    "dev:front": "pnpm --parallel --filter \"./apps/frontend-*\" dev",
    "dev:massimo": "pnpm --filter @zetis/frontend-massimo dev",
    "dev:papa": "pnpm --filter @zetis/frontend-papa dev",
    "dev:back": "cd apps/backend && .venv/bin/uvicorn app.main:app --reload --port 8000",
    "prod:up": "docker compose -f docker-compose.prod.yml up --build",
    "prod:down": "docker compose -f docker-compose.prod.yml down",
    "prod:logs": "docker compose -f docker-compose.prod.yml logs -f"
  }
}
